{
	"name": "underskin",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build:og": "node scripts/generate-og.js",
		"images:webp": "node scripts/convert-webp.js",
		"build": "npm run build:og && npm run images:webp && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^25.9.0",
		"autoprefixer": "^10.5.2",
		"postcss": "^8.5.15",
		"sharp": "^0.35.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"d3-delaunay": "^6.0.4",
		"gsap": "^3.15.0",
		"lenis": "^1.3.25",
		"modern-normalize": "^3.0.1",
		"three": "^0.174.0"
	}
}
